FROM python:3.11-slim

WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

COPY pyproject.toml README.md ./
COPY src/ ./src/
COPY configs/ ./configs/

RUN uv sync --extra mlops --no-dev

CMD ["uv", "run", "python", "-c", "from anomalies_elec.config import load_config; print('Worker ready:', load_config().project.name)"]
