FROM python:3.11-slim

WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

COPY pyproject.toml README.md ./
COPY src/ ./src/
COPY configs/ ./configs/

RUN uv sync --extra mlops --no-dev

EXPOSE 8501
CMD ["uv", "run", "streamlit", "run", "src/anomalies_elec/dashboard/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
