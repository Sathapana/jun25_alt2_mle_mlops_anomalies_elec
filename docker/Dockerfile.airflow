# Image Airflow du projet (api-server, scheduler, dag-processor).
#
# Le package `anomalies_elec` n'est PAS installé dans l'environnement Python d'Airflow
# (contraintes de dépendances incompatibles) : il vit dans un virtualenv séparé,
# /opt/anomalies-venv, construit depuis uv.lock. Les DAGs l'appellent via
# `@task.external_python(python=ANOMALIES_PYTHON)` (cf. dags/*.py).
ARG AIRFLOW_VERSION=3.1.3
FROM apache/airflow:${AIRFLOW_VERSION}-python3.11

USER root
COPY --from=ghcr.io/astral-sh/uv:0.10.12 /uv /usr/local/bin/uv

ENV UV_PROJECT_ENVIRONMENT=/opt/anomalies-venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy

WORKDIR /opt/anomalies_elec
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --extra mlops --no-install-project

COPY src/ ./src/
COPY configs/ ./configs/
RUN uv sync --frozen --extra mlops --no-editable \
    && chown -R airflow: /opt/anomalies-venv /opt/anomalies_elec

USER airflow
WORKDIR /opt/airflow
