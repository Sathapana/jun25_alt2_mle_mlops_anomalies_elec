# Configuration de l'environnement MLOps éCO2mix
# Copier en `.env` (ignoré par Git) : docker compose le lit automatiquement.
ANOMALIES_ELEC_CONFIG_PATH=configs/default.yaml

# --- Stockage -----------------------------------------------------------------
# parquet (défaut) | postgres (une fois PostgresStore implémenté par P1)
STORAGE_BACKEND=parquet
DATA_DIR=data
# Depuis l'hôte ; dans les conteneurs, docker-compose utilise l'hôte "postgres".
DATABASE_URL=postgresql+psycopg://anomalies:anomalies@localhost:5432/anomalies

# --- PostgreSQL (docker compose) ----------------------------------------------
POSTGRES_USER=anomalies
POSTGRES_PASSWORD=anomalies
POSTGRES_DB=anomalies

# --- Services -----------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# --- Airflow (développement local uniquement) ---------------------------------
# Secret partagé par l'api-server et le scheduler ; changer la valeur hors poste de dev.
AIRFLOW_JWT_SECRET=change-me-local-dev-only

# --- Grafana ------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
